<style>
  #storyboards {
    display: flex;           /* Arrange children in a row */
    gap: 20px;               /* Space between storyboards */
    justify-content: center; /* Center row horizontally */
    flex-wrap: wrap;         /* Stack on smaller screens */
  }
  .storyboard {
    flex: 1 1 30%;           /* Each takes ~30% width, flexible */
    max-width: 300px;        /* Optional cap */
  }
  .storyboard img {
    width: 100%;             /* Fill container */
  }
  .slideshow {
    position: relative;
    width: 800px;
  }
  .slideshow img.slide {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .slideshow img.arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    cursor: pointer;
  }
  .slideshow .left { left: 10px; }
  .slideshow .right { right: 10px; }
</style>
<script>
  document.querySelectorAll(".slideshow").forEach(container => {
    const images = JSON.parse(container.dataset.images);
    const leftArrow = container.dataset.left;
    const rightArrow = container.dataset.right;

    let index = 0;

    const slide = document.createElement("img");
    slide.className = "slide";
    container.appendChild(slide);

    const prev = document.createElement("img");
    prev.src = leftArrow;
    prev.className = "arrow left";

    const next = document.createElement("img");
    next.src = rightArrow;
    next.className = "arrow right";

    container.appendChild(prev);
    container.appendChild(next);

    function show(i) {
      index = (i + images.length) % images.length;
      slide.src = images[index];
    }
 
    prev.onclick = () => show(index - 1);
    next.onclick = () => show(index + 1);

    show(0);
  });

</script>
</script>
