export default class Lightbox {
    static activate() {
	document.body.insertAdjacentHTML("beforeend", '
         <div class="lightbox" id="lightbox">
<button type="button" class="lightbox__close">
&times;
</button>
<div class="lightbox__content">
This is the main content.
</div>
</div>
</div>
');
    }
}
