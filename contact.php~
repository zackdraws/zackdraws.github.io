<?php
if ($_SERVER["REQUEST_METHOD"] == "POST") {
  $name = $_POST['name'];
  $email = $_POST['email'];
  $message = $_POST['message'];

  $to = "your@email.com";
  $subject = "New message from $name";
  $body = "From: $name <$email>\n\n$message";

  mail($to, $subject, $body);
  echo "Message sent!";
}
?>
