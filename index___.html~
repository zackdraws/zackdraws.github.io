#animation-reel {

  display: flex;

  justify-content: center;  /* Center the content horizontally */

  padding: 2rem;

}



.animation-reel-container {

  display: flex;

  justify-content: space-between;

  width: 100%;

  max-width: 1200px; /* Adjust this based on your design needs */

}



.main-reel {

  flex: 3; /* Main animation reel takes 3/4 of the space */

  margin-right: 20px; /* Optional spacing between the main and sample videos */

}



.main-reel video {

  width: 100%; /* Ensure the video takes up full width */

  height: auto;

}



.sample-reels {

  flex: 1; /* Sample videos take up 1/4 of the space */

  display: flex;

  flex-direction: column;

  gap: 1rem; /* Space between the sample videos */

}



.sample-item video {

  width: 100%;  /* Make sure each sample video fits within the container */

  height: auto;

  border-radius: 8px; /* Optional: border radius for rounded corners */

  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Optional: Add shadow for style */

}



@media (max-width: 768px) {

  .animation-reel-container {

    flex-direction: column; /* Stack the main reel and samples vertically on small screens */

  }



  .main-reel {

    margin-right: 0; /* Remove margin when stacked */

    margin-bottom: 1rem; /* Add margin bottom for spacing */

  }



  .sample-reels {

    flex: 1;

    display: grid;

    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));

    gap: 1rem;

  }



  .sample-item video {

    width: 100%; /* Ensure sample videos take full width in smaller grids */

  }

}
